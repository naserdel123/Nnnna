<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سوق العروض - للجميع</title>
    
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-storage-compat.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            text-align: center;
            color: white;
            padding: 40px 0;
        }

        header h1 {
            font-size: 3em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .main-buttons {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin: 40px 0;
            flex-wrap: wrap;
        }

        .btn {
            padding: 25px 70px;
            font-size: 1.6em;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            font-weight: bold;
        }

        .btn-add {
            background: linear-gradient(45deg, #00b894, #00cec9);
            color: white;
        }

        .btn-offers {
            background: linear-gradient(45deg, #e17055, #fdcb6e);
            color: white;
        }

        .btn:hover {
            transform: translateY(-8px) scale(1.05);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        .add-form {
            display: none;
            background: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            max-width: 700px;
            margin: 0 auto;
            animation: slideIn 0.6s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .add-form h2 {
            text-align: center;
            color: #333;
            margin-bottom: 30px;
            font-size: 2.2em;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            color: #555;
            font-weight: bold;
            font-size: 1.2em;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 18px;
            border: 3px solid #e0e0e0;
            border-radius: 15px;
            font-size: 1.1em;
            transition: all 0.3s;
        }

        .form-group input:focus, .form-group textarea:focus {
            outline: none;
            border-color: #667eea;
            transform: scale(1.02);
        }

        .images-upload {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .image-box {
            border: 3px dashed #ccc;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8f9fa;
            overflow: hidden;
        }

        .image-box:hover {
            border-color: #667eea;
            background: #e8f4f8;
            transform: scale(1.05);
        }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
        }

        .image-box input[type="file"] {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            top: 0;
            left: 0;
        }

        .submit-btn {
            width: 100%;
            padding: 20px;
            background: linear-gradient(45deg, #00b894, #00cec9);
            color: white;
            border: none;
            border-radius: 15px;
            font-size: 1.4em;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
            font-weight: bold;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        .submit-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .offers-section {
            display: none;
        }

        .offers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            padding: 20px 0;
        }

        .offer-card {
            background: white;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            transition: all 0.4s ease;
            animation: fadeInUp 0.6s ease;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .offer-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0,0,0,0.2);
        }

        .offer-images {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3px;
            height: 250px;
            background: #f0f0f0;
        }

        .offer-images img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .offer-images img:hover {
            transform: scale(1.1);
        }

        .offer-info {
            padding: 30px;
        }

        .offer-info h3 {
            color: #2d3436;
            font-size: 1.8em;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 12px 25px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-radius: 30px;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .social-link:hover {
            transform: scale(1.1);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.4);
        }

        .date {
            color: #b2bec3;
            font-size: 0.95em;
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .back-btn {
            background: #636e72;
            color: white;
            padding: 15px 35px;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            margin-bottom: 25px;
            font-size: 1.1em;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-btn:hover {
            background: #2d3436;
            transform: translateX(-5px);
        }

        .empty-state {
            text-align: center;
            color: white;
            padding: 80px 20px;
        }

        .empty-state h2 {
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        .loading {
            text-align: center;
            color: white;
            padding: 50px;
            font-size: 1.3em;
        }

        .spinner {
            border: 5px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top: 5px solid white;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .delete-btn {
            background: #ff7675;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 15px;
            font-size: 1em;
            transition: all 0.3s;
        }

        .delete-btn:hover {
            background: #d63031;
            transform: scale(1.05);
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 10px;
            display: none;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(45deg, #00b894, #00cec9);
            width: 0%;
            transition: width 0.3s;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🛍️ سوق العروض</h1>
            <p>منصة عروض حقيقية للجميع - شاهد العروض من أي مكان!</p>
        </header>

        <div class="main-buttons" id="mainButtons">
            <button class="btn btn-add" onclick="showAddForm()">➕ إضافة عرض</button>
            <button class="btn btn-offers" onclick="showOffers()">🛒 تصفح العروض</button>
        </div>

        <div class="add-form" id="addForm">
            <h2>🚀 أضف عرضك الآن</h2>
            <form onsubmit="submitOffer(event)">
                <div class="form-group">
                    <label>📦 اسم المنتج</label>
                    <input type="text" id="productName" required placeholder="مثال: آيفون 14 برو ماكس">
                </div>

                <div class="form-group">
                    <label>🔗 رابط التواصل الاجتماعي</label>
                    <input type="url" id="socialLink" required placeholder="رابط Instagram, Twitter, Snapchat...">
                </div>

                <div class="form-group">
                    <label>📸 صور المنتج (4 صور)</label>
                    <div class="images-upload">
                        <div class="image-box" id="box0">
                            <span style="font-size: 2em;">📷</span>
                            <span>اضغط لإضافة صورة</span>
                            <input type="file" accept="image/*" onchange="previewImage(this, 0)" required>
                        </div>
                        <div class="image-box" id="box1">
                            <span style="font-size: 2em;">📷</span>
                            <span>اضغط لإضافة صورة</span>
                            <input type="file" accept="image/*" onchange="previewImage(this, 1)" required>
                        </div>
                        <div class="image-box" id="box2">
                            <span style="font-size: 2em;">📷</span>
                            <span>اضغط لإضافة صورة</span>
                            <input type="file" accept="image/*" onchange="previewImage(this, 2)" required>
                        </div>
                        <div class="image-box" id="box3">
                            <span style="font-size: 2em;">📷</span>
                            <span>اضغط لإضافة صورة</span>
                            <input type="file" accept="image/*" onchange="previewImage(this, 3)" required>
                        </div>
                    </div>
                </div>

                <div class="progress-bar" id="progressBar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">
                    نشر العرض للجميع 🌍
                </button>
                <button type="button" class="back-btn" onclick="showMain()" style="width: 100%; margin-top: 15px; justify-content: center;">
                    ↩️ رجوع
                </button>
            </form>
        </div>

        <div class="offers-section" id="offersSection">
            <button class="back-btn" onclick="showMain()">
                ↩️ رجوع للرئيسية
            </button>
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p>جاري تحميل العروض...</p>
            </div>
            <div class="offers-grid" id="offersGrid" style="display: none;"></div>
            <div class="empty-state" id="emptyState" style="display: none;">
                <h2>📭 لا توجد عروض حالياً</h2>
                <p>كن أول من يضيف عرض ويستفيد الجميع!</p>
            </div>
        </div>
    </div>

    <script>
        // ⚠️ هنا تضع بيانات Firebase الخاصة بك
        const firebaseConfig = {
            apiKey: "AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
            authDomain: "your-project.firebaseapp.com",
            projectId: "your-project-id",
            storageBucket: "your-project.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef123456"
        };

        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const storage = firebase.storage();

        let currentImages = [null, null, null, null];
        let imageFiles = [null, null, null, null];

        function showAddForm() {
            document.getElementById('mainButtons').style.display = 'none';
            document.getElementById('addForm').style.display = 'block';
            document.getElementById('offersSection').style.display = 'none';
        }

        async function showOffers() {
            document.getElementById('mainButtons').style.display = 'none';
            document.getElementById('addForm').style.display = 'none';
            document.getElementById('offersSection').style.display = 'block';
            document.getElementById('loading').style.display = 'block';
            document.getElementById('offersGrid').style.display = 'none';
            document.getElementById('emptyState').style.display = 'none';
            
            await loadOffers();
        }

        function showMain() {
            document.getElementById('mainButtons').style.display = 'flex';
            document.getElementById('addForm').style.display = 'none';
            document.getElementById('offersSection').style.display = 'none';
            resetForm();
        }

        function resetForm() {
            document.querySelector('form').reset();
            currentImages = [null, null, null, null];
            imageFiles = [null, null, null, null];
            for (let i = 0; i < 4; i++) {
                const box = document.getElementById(`box${i}`);
                box.innerHTML = `
                    <span style="font-size: 2em;">📷</span>
                    <span>اضغط لإضافة صورة</span>
                    <input type="file" accept="image/*" onchange="previewImage(this, ${i})" required>
                `;
            }
            document.getElementById('progressBar').style.display = 'none';
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('submitBtn').textContent = 'نشر العرض للجميع 🌍';
        }

        function previewImage(input, index) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentImages[index] = e.target.result;
                    imageFiles[index] = input.files[0];
                    const box = document.getElementById(`box${index}`);
                    box.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;">`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function submitOffer(e) {
            e.preventDefault();
            
            const productName = document.getElementById('productName').value;
            const socialLink = document.getElementById('socialLink').value;
            
            if (imageFiles.includes(null)) {
                alert('⚠️ الرجاء إضافة جميع الصور الأربعة');
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            const progressBar = document.getElementById('progressBar');
            const progressFill = document.getElementById('progressFill');
            
            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ جاري الرفع...';
            progressBar.style.display = 'block';

            try {
                // رفع الصور إلى Firebase Storage
                const imageUrls = [];
                for (let i = 0; i < 4; i++) {
                    const file = imageFiles[i];
                    const storageRef = storage.ref(`offers/${Date.now()}_${i}_${file.name}`);
                    
                    const uploadTask = storageRef.put(file);
                    
                    // متابعة التقدم
                    uploadTask.on('state_changed', 
                        (snapshot) => {
                            const progress = ((i + (snapshot.bytesTransferred / snapshot.totalBytes)) / 4) * 100;
                            progressFill.style.width = progress + '%';
                        }
                    );
                    
                    await uploadTask;
                    const url = await storageRef.getDownloadURL();
                    imageUrls.push(url);
                }

                // حفظ البيانات في Firestore
                await db.collection('offers').add({
                    productName: productName,
                    socialLink: socialLink,
                    images: imageUrls,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                    date: new Date().toLocaleString('ar-SA')
                });

                alert('✅ تم نشر العرض بنجاح! يمكن للجميع رؤيته الآن');
                showMain();
                
            } catch (error) {
                console.error('Error:', error);
                alert('❌ حدث خطأ: ' + error.message);
                submitBtn.disabled = false;
                submitBtn.textContent = 'نشر العرض للجميع 🌍';
            }
        }

        async function loadOffers() {
            try {
                const snapshot = await db.collection('offers')
                    .orderBy('timestamp', 'desc')
                    .get();
                
                const grid = document.getElementById('offersGrid');
                const loading = document.getElementById('loading');
                const emptyState = document.getElementById('emptyState');
                
                loading.style.display = 'none';
                
                if (snapshot.empty) {
                    emptyState.style.display = 'block';
                    return;
                }
                
                grid.style.display = 'grid';
                grid.innerHTML = '';
                
                snapshot.forEach(doc => {
                    const offer = doc.data();
                    const card = createOfferCard(offer, doc.id);
                    grid.appendChild(card);
                });
                
        
